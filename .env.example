# Copy to .env.local and fill in. .env.local is gitignored.

# OpenRouter API key — get one at https://openrouter.ai/keys
# A few US$ of credit is enough for the entire POC.
OPENROUTER_API_KEY=sk-or-v1-...

# Default model. Override at runtime by editing this value and restarting `pnpm dev`,
# or per-call via ComposeRequest.modelOverride from the client.
#
# Recommended defaults (full list and tradeoffs in docs/llm-providers.md):
#   anthropic/claude-sonnet-4.6   # best price/quality balance — default for the demo
#   anthropic/claude-opus-4.7     # highest quality, ~5x cost — save for the recorded take
#   openai/gpt-4o                 # strong baseline, fast, common in reviewer setups
#   google/gemini-2.5-pro         # different stylistic flavor, good for comparisons
#   mistralai/mistral-large       # European option
#   meta-llama/llama-3.3-70b-instruct  # open-weights baseline
#
# Lock the exact id you used for the paper — these strings can shift on OpenRouter.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Optional: OpenRouter's analytics headers. Visible on your OpenRouter dashboard.
OPENROUTER_SITE_URL=https://localhost:5173
OPENROUTER_APP_NAME=virtual.band
